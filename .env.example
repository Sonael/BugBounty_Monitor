# ============================================================
# .env.example — copie para .env e preencha com seus valores
# ============================================================

# ── Banco de Dados (PostgreSQL) ──────────────────────────────
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=your_database_name
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql://your_postgres_user:your_postgres_password@db:5432/your_database_name

# ── Redis / Celery ───────────────────────────────────────────
# db=0: Celery broker (filas de tasks)
# db=1: Cache Python (crt.sh, WAF, mutex de despacho)
# db=2: Flask-Limiter (contagem de rate limit)
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_HOST=redis

# ── Flask ────────────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here

# Concorrência máxima de scans simultâneos no sistema inteiro.
GLOBAL_SCAN_CONCURRENCY=2

# Duração do cookie "lembre-me" (dias).
SESSION_DAYS=30

# ── Usuário Administrador Inicial ────────────────────────────
ADMIN_USER=admin_username
ADMIN_PASSWORD=strong_admin_password

# ── Notificações Discord ─────────────────────────────────────
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ── OAST / Interactsh (blind SSRF/RCE/XSS) ───────────────────
# Servidor próprio recomendado: https://github.com/projectdiscovery/interactsh
# Sem isso, Nuclei usa o público (rate-limitado) e Dalfox roda sem --blind.
INTERACTSH_URL=

# ── Subfinder ────────────────────────────────────────────────
SUBFINDER_THREADS=100

# ── Amass ────────────────────────────────────────────────────
# ATENÇÃO: AMASS_TIMEOUT é em MINUTOS (default do Amass v4), não segundos.
AMASS_TIMEOUT=29

# ── HTTPX ────────────────────────────────────────────────────
HTTPX_THREADS=50
HTTPX_RATE_LIMIT=150

# ── Naabu (Port Scan) ────────────────────────────────────────
# Configurações de chunking para projetos com muitos subdomínios.
NAABU_CHUNK_SIZE=500
NAABU_CHUNK_TIMEOUT=600
NAABU_RATE=1000
NAABU_TOP_PORTS=100
NAABU_RETRIES=1
NAABU_PKT_TIMEOUT=5
# Pula IPs de CDN conhecidas (Cloudflare, Akamai, Fastly, etc.).
NAABU_EXCLUDE_CDN=true
# Quando true, escaneia portas em TODOS os subs (não só os alive em 80/443).
# Captura admin panels em :8080/:8443 ao custo de 5-10× mais tempo.
NAABU_FULL_SWEEP=false

# ── Nuclei ───────────────────────────────────────────────────
NUCLEI_TAGS=cve,misconfig,exposure,tech,panel,xss,sqli,lfi,ssrf,rce,oast,takeover,default-login,fuzzing
# 'info' incluído — templates info detectam leaks de versão, takeover indicators, etc.
NUCLEI_SEVERITY=info,low,medium,high,critical
NUCLEI_CONCURRENCY=50
NUCLEI_TIMEOUT=10
NUCLEI_RETRIES=2
# Rate-limit global (req/s) — evita burst que dispara WAF/IDS.
NUCLEI_RATE_LIMIT=150

# ── Katana ───────────────────────────────────────────────────
KATANA_DEPTH=3
# Ignora variações de query strings (impede milhares de URLs duplicadas).
KATANA_IGNORE_QUERY=true

# ── Dalfox ───────────────────────────────────────────────────
DALFOX_TIMEOUT=10
# Blind XSS callback (default = INTERACTSH_URL acima).
DALFOX_BLIND_URL=

# ── SQLMap ───────────────────────────────────────────────────
SQLMAP_RISK=2
SQLMAP_LEVEL=3
SQLMAP_THREADS=4
# Sem 'T' (time-based) por default — muito lento em listas grandes.
SQLMAP_TECHNIQUE=BEU
# Timeout das técnicas time-based em segundos.
SQLMAP_TIME_SEC=10
# Tampers manuais (ex: 'between,space2comment'). Vazio = aplica automático se WAF detectado.
SQLMAP_TAMPER=
# Delay entre requests em segundos (0 = sem delay).
SQLMAP_DELAY=0

# ── FFuf ─────────────────────────────────────────────────────
FFUF_MAXTIME=90
# Wordlist (raft-medium > common — common.txt é o fallback automático).
FFUF_WORDLIST=/opt/wordlists/raft-medium-directories.txt
# Profundidade de recursão (0 = sem recursão).
FFUF_RECURSION=1

# ── GAU ──────────────────────────────────────────────────────
GAU_BLACKLIST=png,jpg,jpeg,gif,css,svg,woff,woff2,ico,ttf,eot

# ── CMSeeK ───────────────────────────────────────────────────
# CMSeeK não tem modo batch. Em projetos com mais hosts vivos que este
# threshold, o CMSeeK é pulado para não bloquear o scan por horas.
CMSEEK_MAX_HOSTS=50

# ── Caps de URLs (Dalfox/SQLMap) ─────────────────────────────
# Após dedup, trunca o arquivo para no máximo N URLs. Sem isso, alvos
# grandes geram 50k+ URLs e o vuln scan estoura o timeout sem produzir
# resultado útil.
MAX_DALFOX_URLS=10000
MAX_SQLMAP_URLS=5000
